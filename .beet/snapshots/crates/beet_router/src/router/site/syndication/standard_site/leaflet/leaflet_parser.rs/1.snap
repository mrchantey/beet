<h1>
	Full Stack Bevy
</h1>
<p>
	A paragraph with 
	<em>
		emphasis
	</em>
	, 
	<strong>
		strong 
		<em>
			and nested
		</em>
	</strong>
	, 
	<code>
		code
	</code>
	 and 
	<a href="../docs">
		a link
	</a>
	.
</p>
<h2>
	Lists
</h2>
<ul>
	<li>
		<div>
			one
		</div>
		<ul>
			<li>
				one a
			</li>
		</ul>
	</li>
	<li>
		two
	</li>
</ul>
<ol start="3">
	<li>
		three
	</li>
	<li>
		four
	</li>
</ol>
<blockquote>
	<p>
		A quote with 
		<em>
			emphasis
		</em>
		.
	</p>
	<p>
		A second paragraph.
	</p>
</blockquote>
<pre>
	<code class="rust">
		fn main() { println!(&quot;hello&quot;); }

	</code>
</pre>
