                "children": [
                  {
                    "$type": "pub.leaflet.blocks.unorderedList#listItem",
                    "content": {
                      "$type": "pub.leaflet.blocks.text",
                      "plaintext": "ie http headers, tool caching instructions"
                    }
                  }
                ],
                "content": {
                  "$type": "pub.leaflet.blocks.text",
                  "facets": [
                    {
                      "features": [
                        {
                          "$type": "pub.leaflet.richtext.facet#code"
                        }
                      ],
                      "index": {
                        "byteEnd": 37,
                        "byteStart": 9
                      }
                    }
                  ],
                  "plaintext": "headers: HashMap<String, Vec<String>>"
                }
              },
