                        "byteStart": 0
                      }
                    }
                  ],
                  "plaintext": "YouTube"
                }
              }
            ]
          }
        },
        {
          "$type": "pub.leaflet.pages.linearDocument#block",
          "block": {
            "$type": "pub.leaflet.blocks.text",
            "facets": [
              {
                "features": [
                  {
                    "$type": "pub.leaflet.richtext.facet#code"
                  }
                ],
                "index": {
                  "byteEnd": 78,
                  "byteStart": 69
                }
              },
              {
                "features": [
                  {
                    "$type": "pub.leaflet.richtext.facet#code"
                  }
                ],
                "index": {
                  "byteEnd": 92,
                  "byteStart": 83
                }
              }
            ],
            "plaintext": "This is a great breakdown on two pioneers in malleable applications: smalltalk and hypercard."
          }
        },
        {
          "$type": "pub.leaflet.pages.linearDocument#block",
          "block": {
            "$type": "pub.leaflet.blocks.header",
            "level": 2,
            "plaintext": "InkAndSwitch - Malleable Software"
          }
        },
        {
          "$type": "pub.leaflet.pages.linearDocument#block",
          "block": {
            "$type": "pub.leaflet.blocks.unorderedList",
            "children": [
              {
                "$type": "pub.leaflet.blocks.unorderedList#listItem",
                "content": {
                  "$type": "pub.leaflet.blocks.text",
                  "facets": [
                    {
                      "features": [
                        {
                          "$type": "pub.leaflet.richtext.facet#link",
                          "uri": "https://www.inkandswitch.com/essay/malleable-software/"
                        }
                      ],
                      "index": {
                        "byteEnd": 5,
                        "byteStart": 0
                      }
                    }
                  ],
                  "plaintext": "Essay"
                }
              }
            ]
          }
        },
        {
          "$type": "pub.leaflet.pages.linearDocument#block",
          "block": {
            "$type": "pub.leaflet.blocks.text",
            "plaintext": "The phrasing used in this essay is really growing on me. The term 'malleable' has this tangible quality I really like, and reflects well this idea of technology that can be bent into shape without breaking."
          }
        },
        {
          "$type": "pub.leaflet.pages.linearDocument#block",
          "block": {
            "$type": "pub.leaflet.blocks.header",
            "level": 2,
            "plaintext": "Maggie Appleton: Bare-foot developers"
          }
        },
        {
          "$type": "pub.leaflet.pages.linearDocument#block",
          "block": {
            "$type": "pub.leaflet.blocks.unorderedList",
            "children": [
              {
                "$type": "pub.leaflet.blocks.unorderedList#listItem",
                "content": {
                  "$type": "pub.leaflet.blocks.text",
                  "facets": [
                    {
                      "features": [
