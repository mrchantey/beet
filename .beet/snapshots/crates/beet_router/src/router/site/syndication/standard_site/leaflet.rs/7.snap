                  ],
                  "plaintext": "Blog Post"
                }
              },
              {
                "$type": "pub.leaflet.blocks.unorderedList#listItem",
                "content": {
                  "$type": "pub.leaflet.blocks.text",
                  "facets": [
                    {
                      "features": [
                        {
                          "$type": "pub.leaflet.richtext.facet#link",
                          "uri": "https://youtu.be/qo5m92-9_QI"
                        }
                      ],
                      "index": {
                        "byteEnd": 7,
                        "byteStart": 0
                      }
                    }
                  ],
                  "plaintext": "YouTube"
                }
              }
            ]
          }
        },
        {
          "$type": "pub.leaflet.pages.linearDocument#block",
          "block": {
            "$type": "pub.leaflet.blocks.text",
            "plaintext": "I think Maggie's concept of 'bare-foot developers' well articulates the semi-technical as a key audience for malleable applications."
          }
        }
      ]
    }
  ]
}