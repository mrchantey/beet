<!--
The document layout wrapping every route: a thin use of the shipped <SiteLayout>
shell, which carries the full beet chrome (head/header/sidebar/footer + the body
`page` + color-scheme class). The layout middleware transcludes each route's body
in as SiteLayout's default-slot child, so it lands in <main> with no relay here;
<LiveReloadScript/> and <Wasm/> append to the head chrome, and the sidebar
override excludes the `export` route.

<Wasm/> is what makes the served page a launch: the browser boots the wasm
`beet` binary on this same entry (`main.bsx` read through the `/repo` store the
entry publishes) under `--server=dom`, so the page's world runs in the tab and
its event scripts (`routes/counter.bsx`) run on click.
-->
<SiteLayout>
	<LiveReloadScript slot="head"/>
	<Wasm src="/assets/wasm/beet-ui.wasm" repo="/repo" main="main.bsx" server="dom" slot="head"/>
	<RouteSidebar home=false exclude={["export"]} slot="sidebar"/>
</SiteLayout>
