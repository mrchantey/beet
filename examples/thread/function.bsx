<!--
A thread run as a function: a request in, an answer out, nobody typing. Run it
through the one binary:

    beet --entry=examples/thread/function.bsx review oneshot.bsx
    beet --entry=examples/thread/function.bsx review oneshot.bsx --new   # a fresh thread
    beet --entry=examples/thread/function.bsx --server=http              # GET /review/oneshot.bsx

`{ThreadRoute}` builds `templates/ReviewThread.bsx` for each request, enters the
thread its store path names, posts `message` with `{document}` filled from the
request, runs the thread to its outcome and answers the reviewer's last text. The
threads are rows keyed under `reviews/`, in the `thread*` directories beside this
file, so a second review of a document continues its thread.

The reviewer's one tool is `<RouteTool path="read-blob"/>`, the `read-blob` route of
this url space, forwarded to as a call of the agent's own.
-->
<CallOnReady {(CliServer, HttpServer{default_boot:false})}>
	<RequireCfg cfg="feature:thread"/>
	<Router {HelpHandler}>
		<StoreToolset read_only=true/>
		<Route path="review/:document" {ThreadRoute{source:Document("templates/ReviewThread.bsx"), message:"Review the document {document}."}}/>
	</Router>
</CallOnReady>
