<!--
Two people chatting: a thread with no agent and no behavior, open in two windows at
once. Run it through the one binary, serving the local terminal and ssh:

    beet --entry=examples/thread/people_chat.bsx --server=tui,ssh
    ssh -t -p 8339 localhost /guest   # from another terminal

Each `<Thread>` is a window onto the one thread stored under `people_chat`, with its
own view and composer, Ann's at `/` and Bob's at `/guest`. A post in either shows in
both at once (window sync) and is stored once, so a re-run continues the chat. Press
Tab to reach a composer that has no focus, since two pages each ask for it.

Adding `http` to the servers serves the same pages to a browser, to read: each load
renders the window as it stands, and a served page's composer posts nothing.

One `{RunThread}` holds both windows and enters them in order, so the second finds
the thread the first created. There is nothing to run: people post whenever they
like. The actor ids are pinned so each run's actors are the stored thread's.
-->
<CallOnReady {(TuiServer, HttpServer{default_boot:false}, SshTuiServer{default_boot:false}, SweepDescendants)}>
	<RequireCfg cfg="feature:thread && feature:tui && feature:ssh"/>
	<Router {Layout{template:"AppShell"}}>
		<Route path="/" {FixedPage}>
			<ThreadView {OfThread($home)}/>
			<CreatePostForm actor=1 {OfThread($home)}/>
		</Route>
		<Route path="guest" {FixedPage}>
			<ThreadView {OfThread($guest)}/>
			<CreatePostForm actor=2 {OfThread($guest)}/>
		</Route>
		<Fragment {RunThread}>
			<Thread bx:ref="home" {MountThreadStore{path:"people_chat"}}>
				<CreateActor id=1 name="Ann" kind="User"/>
			</Thread>
			<Thread bx:ref="guest" {MountThreadStore{path:"people_chat"}}>
				<CreateActor id=2 name="Bob" kind="User"/>
			</Thread>
		</Fragment>
	</Router>
</CallOnReady>
