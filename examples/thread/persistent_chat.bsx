<!--
A chat whose conversation persists to disk across runs. Run it through the one
binary:

    beet --entry=examples/thread/persistent_chat.bsx
    beet --entry=examples/thread/persistent_chat.bsx --new   # start fresh

`{MountThreadStore}` persists the thread as a partition of rows, listed under its
path in the table store around it; `{RunThread}` continues the newest thread stored there
before the first turn, so a re-run resumes where it left off. `--new` starts a fresh
thread, which the next run continues. The system
prompt is the seed, written once when a thread is created, so an edited prompt
reaches a new thread only. Each actor's id is its name in kebab-case, so each run's
actors are the stored thread's.

The table store here is `{JsonTableStore}`, rows as json files in a directory, one
a thread and `target/persistent_chat/@root.json` listing them, which any binary runs
and a person reads. Each
write costs the size of the file, so a chat kept for years belongs in a database. With
the `sqlite` feature, swap the line declaring it for:

    <SqliteStore path="target/persistent_chat.db">
-->
<CallOnReady {(TuiServer, HttpServer{default_boot:false}, SshTuiServer{default_boot:false}, SweepDescendants)}>
	<RequireCfg cfg="feature:thread && feature:tui && feature:ssh"/>
	<Router {Layout(Template("AppShell"))}>
		<Route path="/" {FixedPage}>
			<ThreadView {OfThread($thread)}/>
			<CreatePostForm {OfThread($thread)}/>
		</Route>
		<FsStore path="target/persistent_chat" {JsonTableStore}>
			<Repeat {RunThread}>
				<Thread bx:ref="thread" {(Sequence, MountThreadStore{path:"persistent_chat"})}>
					<CreateActor name="System" kind="System">
						<CreatePost text="Ask a single brief, challenging question about the user's life choices. Followup with more brief questions based on the users' answers"/>
					</CreateActor>
					<CreateActor name="Agent" kind="Agent" {ModelStreamer{provider:OpenAi}}/>
					<CreateActor name="User" kind="User" {UserInput}/>
				</Thread>
			</Repeat>
		</FsStore>
	</Router>
</CallOnReady>
