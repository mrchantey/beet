<!--
The simplest thread: one agent, one turn, no loop. Run it through the one binary:

    beet --main=examples/thread/oneshot.bsx

`{RunThread}` calls the `{Sequence}` once (the system seed, then the agent's
single reply). The run is finite, so the transcript settles and the terminal
holds it until Ctrl+C; process lifetime belongs to the servers, not the thread.
-->
<Fragment {(TuiServer, HttpServer{default_boot:false}, SshTuiServer{default_boot:false}, CallOnLoad)}>
	<CrateCheck features="thread,tui,ssh"/>
	<Router {ThreadLayout}>
		<Route path="/" {FixedPage}>
			<ThreadView {OfThread($thread)}/>
		</Route>
		<Thread bx:ref="thread" {(Sequence, RunThread)}>
			<CreateActor name="System" kind="System">
				<CreatePost text="make like a duck and quack"/>
			</CreateActor>
			<CreateActor name="Agent" kind="Agent" {ModelStreamer{provider:OpenAi}}/>
		</Thread>
	</Router>
</Fragment>
