<!--
Interactive terminal chat, the whole program in one scene. Run it through the
one binary:

    beet --main=examples/thread/chat.bsx

The behavior is `Repeat[Sequence[agent, user]]`: the agent greets from the system
prompt, the user's turn (`{UserInput}`) waits for the composer, looped forever.
`{RunThread}` runs it on the servers' start notification.

The entry is a server root with a router child, like every other beet entry: a
bare run boots the local `TuiServer` only, `--server=http` serves the same page
as html and `--server=ssh` over a terminal per connection (structure only, not
verified). `--color-scheme=light|dark` seeds the session theme, which the layout
pins per request.

The page is a `{FixedPage}` route: its children are one live tree served by every
request, so the view and composer stay bound to the thread the loop drives (the
`bx:ref="thread"` / `$thread` reference) and repaint reactively. The behavior tree
is a sibling of the page, kicked by the same start.
-->
<CallOnReady {(TuiServer, HttpServer{default_boot:false}, SshTuiServer{default_boot:false})}>
	<CrateCheck features="thread,tui,ssh"/>
	<Router {ThreadLayout}>
		<Route path="/" {FixedPage}>
			<ThreadView {OfThread($thread)}/>
			<CreatePostForm {OfThread($thread)}/>
		</Route>
		<Repeat {RunThread}>
			<Thread bx:ref="thread" {Sequence}>
				<CreateActor name="System" kind="System">
					<CreatePost text="you are robot, make beep boop noises"/>
				</CreateActor>
				<CreateActor name="BeepBot" kind="Agent" {ModelStreamer{provider:OpenAi}}/>
				<CreateActor name="Billy" kind="User" {UserInput}/>
			</Thread>
		</Repeat>
	</Router>
</CallOnReady>
