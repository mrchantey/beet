<!--
# Hello Lightsail

Deploys `examples/bsx_site` as an http-only Lightsail instance. The generic `beet`
binary runs under systemd and reads the site from an S3 bucket at request time
(its `ExecStart` passes `--store=s3://<bucket> --server=http`), so a site change
re-publishes by re-running `sync` with no redeploy. Served on the instance's
public address.

This is `lambda` with the block swapped for a long-running VM: the deploy/sync/
watch shape and the served content are identical (see `crates/beet_extra/src/infra`).

## Usage

    beet --main=examples/infra/lightsail.bsx validate
    beet --main=examples/infra/lightsail.bsx deploy
    beet --main=examples/infra/lightsail.bsx sync
    beet --main=examples/infra/lightsail.bsx watch
    beet --main=examples/infra/lightsail.bsx destroy --force

Live deploy needs AWS credentials in the environment, plus `tofu` and `cargo-zigbuild`.
-->
<CliServer {CallOnReady}>
<Router {(RequestLogger, HelpHandler)}>
	<CrateCheck features={["infra", "extra"]}/>
	<Stack app_name="lightsail">
		<DeployRoutes/>
		<Route path="deploy" {ExchangeSequence}>
			<!-- the block + its build artifact share one entity (the deploy pairs them) -->
			<LightsailSiteBlock features="aws_sdk"/>
			<S3BucketBlock label="app" deploy_versioned=false/>
			<!-- the bucket first, so the site is in place before the instance that
			     serves it boots -->
			<TofuApply layer="storage"/>
			<SiteSync/>
			<TofuApply/>
			<LightsailWatch timeout="30s"/>
		</Route>
		<Route path="sync" {ExchangeSequence}>
			<SiteSync/>
		</Route>
		<Route path="watch" {ExchangeSequence}>
			<LightsailWatch/>
		</Route>
	</Stack>
</Router>
</CliServer>
