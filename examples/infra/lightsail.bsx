<!--
# Hello Lightsail

Deploys `examples/beetmania` as an http-only Lightsail instance. The generic `beet`
binary runs under systemd and reads the site from an S3 bucket at request time
(its `ExecStart` passes `--home=s3://<bucket> --server=http serve`, `serve`
being the example's command that IS the site), so a site change re-publishes by
re-running `sync` with no redeploy. Served on the instance's public address. Run
`just beetmania assets` first, so the files the site borrows and derives are in
the tree it publishes.

This is `lambda` with the block swapped for a long-running VM: the deploy/sync/
watch shape and the served content are identical (see `crates/beet_extra/src/infra`).

## Usage

    beet --entry=examples/infra/lightsail.bsx validate
    beet --entry=examples/infra/lightsail.bsx deploy
    beet --entry=examples/infra/lightsail.bsx sync
    beet --entry=examples/infra/lightsail.bsx watch
    beet --entry=examples/infra/lightsail.bsx ssh
    beet --entry=examples/infra/lightsail.bsx destroy --force

Live deploy needs AWS credentials in the environment, plus `tofu` and `cargo-zigbuild`.
-->
<CliServer {CallOnReady}>
<Router {(RequestLogger, HelpHandler)}>
	<RequireCfg cfg="feature:infra && feature:extra"/>
	<Stack app_name="lightsail" {AwsRegion("us-west-2")}>
		<Group bx:ref="deploy_up">
			<!-- the block + its build artifact share one entity (the deploy pairs them) -->
			<LightsailSiteBlock features="aws" exec_route="serve"/>
			<S3BucketBlock label="repo" {HomeStoreBlock}/>
			<!-- the ssh authority the box trusts, before the apply that boots it -->
			<EnsureSshAuthority/>
			<!-- the bucket first, so the site is in place before the instance that
			     serves it boots -->
			<TofuApply layer="storage"/>
			<!-- publish the site: assemble it, then one mirror into this deploy's
			     version of the home store -->
			<!-- the wasm runtime the site's pages boot, built by this verb rather
			     than borrowed: the assemble reads it through the site's `wasm/` links -->
			<WasmRuntime package="beet-cli" bin="beet" features="web_ui" out="target/wasm/beet-ui.wasm"/>
			<HomeAssemble src="examples/beetmania"/>
			<HomeSync/>
			<TofuApply/>
			<LightsailWatch timeout="30s"/>
		</Group>
		<Group bx:ref="deploy_down">
			<StackTeardown/>
			<TofuDestroy/>
		</Group>
		<DeployRoutes deploy={$deploy_up} destroy={$deploy_down}/>
		<!-- a shell on the box, logged in through the stack's ssh authority -->
		<Route path="ssh" {SshShell}/>
		<!-- a content-only republish, into the version the running service was
		     built against rather than a fresh one nothing reads -->
		<Route path="sync" {ExchangeSequence}>
			<AdoptCurrentDeploy/>
			<!-- the wasm runtime the site's pages boot, built by this verb rather
			     than borrowed: the assemble reads it through the site's `wasm/` links -->
			<WasmRuntime package="beet-cli" bin="beet" features="web_ui" out="target/wasm/beet-ui.wasm"/>
			<HomeAssemble src="examples/beetmania"/>
			<HomeSync/>
		</Route>
		<Route path="watch" {ExchangeSequence}>
			<LightsailWatch/>
		</Route>
	</Stack>
</Router>
</CliServer>
