<!--
# Bucket Lifecycle

Stands up a stack with a single S3 bucket, then exercises its full lifecycle
(validate / plan / apply, write a file to the bucket's BlobStore + read it back,
destroy), logging each step. Switch the tofu state backend between local and S3
with `--s3-backend`.

## Usage

    beet --entry=examples/infra/bucket.bsx run               # local backend
    beet --entry=examples/infra/bucket.bsx run --s3-backend  # s3 backend

Live run needs AWS credentials and `tofu`.
-->
<CliServer {(CallOnReady, RejectUnknownParams)}>
<!-- the state backend is a property of the LAUNCH, not of a stack's identity, so
     the toggle is router middleware reading `--s3-backend` off the request and
     landing it on the process `Deployment` -->
<Router {(RequestLogger, HelpHandler, StateBackendToggle)}>
	<RequireCfg cfg="feature:infra && feature:extra"/>
	<Stack app_name="bucket-example" {AwsRegion("us-west-2")}>
		<Group bx:ref="deploy_up">
			<TofuApply/>
		</Group>
		<Group bx:ref="deploy_down">
			<StackTeardown/>
			<TofuDestroy/>
		</Group>
		<DeployRoutes deploy={$deploy_up} destroy={$deploy_down}/>
		<Route path="run" {ExchangeSequence}>
			<!-- written in place with no object versions, so the render demands the
			     admission: the probe's one file is disposable by design -->
			<S3BucketBlock label="my-bucket" deploy_versioned=false accept_data_loss=true {LifecycleProbe}/>
		</Route>
	</Stack>
</Router>
</CliServer>
