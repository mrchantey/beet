<!--
# Bucket Lifecycle

Stands up a stack with a single S3 bucket, then exercises its full lifecycle
(validate / plan / apply, write a file to the bucket's BlobStore + read it back,
destroy), logging each step. Switch the tofu state backend between local and S3
with `--s3-backend`.

## Usage

    beet --main=examples/infra/bucket.bsx run               # local backend
    beet --main=examples/infra/bucket.bsx run --s3-backend  # s3 backend

Live run needs AWS credentials and `tofu`.
-->
<CliServer {CallOnReady}>
<Router {(RequestLogger, HelpHandler)}>
	<CrateCheck features={["infra", "extra"]}/>
	<!-- the state backend is a property of the LAUNCH, not of a stack's identity,
	     so the toggle sits outside the stack and lands on the process `Deployment` -->
	<StateBackendToggle/>
	<Stack app_name="bucket-example">
		<DeployRoutes/>
		<Route path="run" {ExchangeSequence}>
			<S3BucketBlock label="my-bucket" deploy_versioned=false {LifecycleProbe}/>
		</Route>
	</Stack>
</Router>
</CliServer>
