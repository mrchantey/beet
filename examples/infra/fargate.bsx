<!--
# Hello Fargate

Deploys `examples/bsx_site` as an http-only Fargate service. The generic `beet`
binary runs in the container and reads the site from an S3 bucket at request time
(the block bakes `--store=s3://<bucket> --server=http` into the container `CMD`),
so a site change re-publishes by re-running `sync` with no image rebuild. The ALB
serves http on its own DNS name (no custom domain).

Unlike the lambda/lightsail blocks (whose binary rides the S3 artifact ledger, so the
block + build share one entity), fargate bakes the binary into a container image:
`<BeetBinaryBuild/>` and `<BuildDockerImage/>` are separate steps, the image build
reading the freshly built binary.

## Usage

    beet --main=examples/infra/fargate.bsx validate
    beet --main=examples/infra/fargate.bsx deploy
    beet --main=examples/infra/fargate.bsx sync
    beet --main=examples/infra/fargate.bsx watch
    beet --main=examples/infra/fargate.bsx destroy --force

Live deploy needs AWS credentials in the environment, plus `tofu`, `cargo-zigbuild`
and a container engine.
-->
<StackHost app_name="fargate">
	<CrateCheck features="infra,extra"/>
	<Route path="deploy" {ExchangeSequence}>
		<FargateSiteBlock app_name="fargate"/>
		<AppBucket/>
		<BeetBinaryBuild features="aws_sdk"/>
		<TofuApplyAction/>
		<!-- bake the freshly built binary into the container image; the block's
		     bootstrap config (`--store=s3://<bucket> --server=http`) rides the CMD -->
		<BuildDockerImage/>
		<SiteSync app_name="fargate"/>
		<FargateWatch app_name="fargate" timeout="300s"/>
	</Route>
	<Route path="sync" {ExchangeSequence}>
		<SiteSync app_name="fargate"/>
	</Route>
	<Route path="watch" {ExchangeSequence}>
		<FargateWatch app_name="fargate"/>
	</Route>
</StackHost>
