<!--
# Hello Fargate

Deploys `examples/beetmania` as an http-only Fargate service. The generic `beet`
binary runs in the container and reads the site from an S3 bucket at request time
(the block bakes `--package=s3://<bucket> --server=http serve` into the container
`CMD`, `serve` being the example's command that IS the site), so a site change
re-publishes by re-running `sync` with no image rebuild. The ALB serves http on
its own DNS name (no custom domain). Run `just beetmania assets` first, so the
files the site borrows and derives are in the tree it publishes.

Unlike the lambda/lightsail blocks (whose binary rides the package store's artifact
ledger, so the block + build share one entity), fargate bakes the binary into a
container image:
`<BeetBinaryBuild/>` and `<BuildDockerImage/>` are separate steps, the image build
reading the freshly built binary.

## Usage

    beet --entry=examples/infra/fargate.bsx validate
    beet --entry=examples/infra/fargate.bsx deploy
    beet --entry=examples/infra/fargate.bsx sync
    beet --entry=examples/infra/fargate.bsx watch
    beet --entry=examples/infra/fargate.bsx destroy --force

Live deploy needs AWS credentials in the environment, plus `tofu`, `cargo-zigbuild`
and a container engine.
-->
<CliServer {CallOnReady}>
<Router {(RequestLogger, HelpHandler)}>
	<RequireCfg cfg="feature:infra && feature:extra"/>
	<Stack app_name="fargate" {AwsRegion("us-west-2")}>
		<Group bx:ref="deploy_up">
			<FargateSiteBlock exec_route="serve"/>
			<!-- deploy-versioned by default: each deploy publishes the site under
			     its own id and ships a binary baked to read that prefix -->
			<S3BucketBlock label="package" {PackageStoreBlock}/>
			<BeetBinaryBuild features="aws"/>
			<!-- the stores the deploy publishes into: the image registry and the
			     bucket the site is served from -->
			<TofuApply layer="storage"/>
			<!-- bake the freshly built binary into the container image; the block's
			     bootstrap config (`--package=s3://<bucket> --server=http`) rides the CMD -->
			<BuildDockerImage/>
			<!-- publish the site: assemble it, then one mirror into this deploy's
			     version of the package store -->
			<!-- the wasm runtime the site's pages boot, built by this verb rather
			     than borrowed: the assemble reads it through the site's `wasm/` links -->
			<WasmRuntime cargo_package="beet-cli" bin="beet" features="web_ui" out="target/wasm/beet-ui.wasm"/>
			<PackageAssemble src="examples/beetmania"/>
			<PackageSync/>
			<!-- the full apply rolls the service, onto an image that is pushed and a
			     bucket that is filled -->
			<TofuApply/>
			<FargateWatch timeout="300s"/>
		</Group>
		<Group bx:ref="deploy_down">
			<StackTeardown/>
			<TofuDestroy/>
		</Group>
		<DeployRoutes deploy={$deploy_up} destroy={$deploy_down}/>
		<!-- a content-only republish, into the version the running service was
		     built against rather than a fresh one nothing reads -->
		<Route path="sync" {ExchangeSequence}>
			<AdoptCurrentDeploy/>
			<!-- the wasm runtime the site's pages boot, built by this verb rather
			     than borrowed: the assemble reads it through the site's `wasm/` links -->
			<WasmRuntime cargo_package="beet-cli" bin="beet" features="web_ui" out="target/wasm/beet-ui.wasm"/>
			<PackageAssemble src="examples/beetmania"/>
			<PackageSync/>
		</Route>
		<Route path="watch" {ExchangeSequence}>
			<FargateWatch/>
		</Route>
	</Stack>
</Router>
</CliServer>
