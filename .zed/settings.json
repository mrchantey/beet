// https://zed.dev/docs/configuring-zed#settings-files
{
	"languages": {
		"Rust": {
			"enable_language_server": false,
		},
	},
	// "show_completions_on_input": false,
	// "completions": {
	// 	"words": "disabled"
	// },
	// "show_edit_predictions": false,
	// "snippet_sort_order": "inline",
	// "autosave": "off",
	"lsp": {
		"rust-analyzer": {
			"initialization_options": {
				"cargo": {
					// "target": "wasm32-unknown-unknown",
					"features": "all",
					// "features": [],
					// "allTargets": false,
					// "noDefaultFeatures": true,
					// run check on nightly so `nightly` feature's #![feature(..)] compiles (avoids E0554)
					"extraEnv": { "RUSTUP_TOOLCHAIN": "nightly" },
				},
			},
		},
	},
	"file_scan_inclusions": [
		// "target",
		".agents*",
	],
	"file_scan_exclusions": [
		// ".agents/tmp*",
		// ".agents/reference",
		".cargo",
		".beet",
		".claude",
		"site/assets",
		// ".gitignore",
		// ".env.example",
		".github",
		".playwright-cli",
		".vscode",
		"CLAUDE.md",
		"target",
		"rustfmt.toml",
		"CHANGELOG.md",
		"Cargo.lock",
		"**/.git",
		".gitattributes",
		"LICENSE-APACHE.txt",
		"LICENSE-MIT.txt",
		"**/node_modules",
		// "rustc-ice**",
	],
}
