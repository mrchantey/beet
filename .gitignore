# the bucket-synced asset trees, each hydrated from its own shared bucket:
# `./assets` from `beet--shared--assets` (`just beet-shared pull`) and
# `./site/assets` from `beet-site--shared--assets` (`just site-shared pull`).
# The pattern is unanchored, so it covers both.
assets
.agents/*
!.agents/skills
.claude
.playwright-cli
.beet/infra
out.txt
examples/bsx_site/dist
site/dist
examples/thread/persistent_chat.json
examples/router/router_serde.json
examples/todo/todos.json
examples/ui/scene_editor/scene.json

!examples/assets
# a link to the workspace tree: the wasm binary the bsx_site page boots
!examples/bsx_site/assets
Cargo.toml.full
Cargo.toml.basic
target
rustc-ice*
.rustc_info.json
.env
.cache
.vscode/settings.json
dump.*
plan.md
plan2.md
file.pdf

tests/assert.rs
tests/expect.rs

**/codegen
