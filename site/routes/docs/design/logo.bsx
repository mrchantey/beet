<!--
The logo designer: `site/scripts/logo.js` draws the logo from a handful of
parameters, the same file the entry's `<ScriptDerivation>` runs to write the
published `assets/logo` files, and this page puts a control on each. Colours
are tones of the theme's palettes, which `<ThemeData/>` hands the page, over
any keys the visitor stored with the palette editor (`color_schemes`).
Favourites are entities of the visitor's colour preferences document, beside
the theme they wear.
-->
<article {RouteMeta{visibility: RouteVisibility::Unlisted}}>
	<h1>Logo</h1>
	<p>
		The logo is generated by <code>site/scripts/logo.js</code> from the parameters below, every colour a tone of the site theme's palettes. To publish a design, copy its changes from defaults into the script's <code>DEFAULTS</code>: <code>&lt;Derive/&gt;</code> then regenerates <code>assets/logo</code>, the favicon included. The hand drawn original is <a href="/assets/logo/logo-hand-drawn.jpg">here</a>.
	</p>
	<ThemeData/>
	<style>
		.logo-designer { display: grid; grid-template-columns: minmax(16rem, 22rem) 1fr; gap: 1rem; align-items: start; }
		@media (max-width: 60rem) { .logo-designer { grid-template-columns: 1fr; } }
		.logo-designer fieldset { border: 1px solid #8884; border-radius: 0.4rem; margin: 0 0 1rem; display: grid; grid-template-columns: 8rem 1fr 3rem; gap: 0.3rem 0.5rem; align-items: center; }
		.logo-designer legend { font-weight: 600; }
		.logo-designer label { font-size: 0.85em; overflow-wrap: anywhere; }
		.logo-designer output { min-height: 1.2em; font-variant-numeric: tabular-nums; text-align: right; font-size: 0.85em; }
		.logo-designer input[type=range] { width: 100%; }
		.logo-designer .actions { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; }
		.logo-designer fieldset.favourites { display: block; }
		.logo-designer .favourites .actions { margin-bottom: 0.5rem; }
		#logo-favourites { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.3rem; }
		#logo-favourites li { display: grid; grid-template-columns: 1fr auto; gap: 0.3rem; }
		#logo-favourites li.current > button:first-child { outline: 2px solid currentColor; }
		#logo-favourites button { display: flex; align-items: center; gap: 0.5rem; text-align: left; }
		#logo-favourites img { width: 2.5rem; height: 2.5rem; object-fit: contain; border-radius: 0.2rem; }
		#logo-changed { width: 100%; box-sizing: border-box; font-family: ui-monospace, monospace; font-size: 0.8em; }
		#logo-changed.invalid { outline: 2px solid #de3730; }
		#logo-note:empty { display: none; }
		/* a checkerboard, so a transparent background reads as one */
		.logo-stage { position: sticky; top: 1rem; border-radius: 0.4rem; background: repeating-conic-gradient(#8882 0 25%, transparent 0 50%) 0 0 / 1.5rem 1.5rem; }
		#logo-preview { display: grid; place-items: center; padding: 1rem; }
		#logo-preview svg { width: min(100%, 70vh); height: auto; }
		#logo-gaps { display: flex; gap: 0.5rem; padding: 0.5rem; border-top: 1px solid #8884; overflow-x: auto; }
		#logo-gaps button { background: none; border: 1px solid #8884; border-radius: 0.4rem; padding: 0.3rem; cursor: pointer; color: inherit; font-size: 0.8em; }
		#logo-gaps img { width: 4.5rem; height: 4.5rem; display: block; object-fit: contain; }
	</style>
	<div class="logo-designer">
		<div>
			<fieldset class="favourites">
				<legend>Favourites</legend>
				<div class="actions">
					<button id="logo-save" type="button" class="btn btn-tonal">Save</button>
					<button id="logo-save-as" type="button" class="btn btn-tonal">Save as…</button>
				</div>
				<ul id="logo-favourites"></ul>
			</fieldset>
			<form id="logo-controls"></form>
			<div class="actions">
				<button id="logo-reset" type="button" class="btn btn-outlined">Reset</button>
				<button id="logo-swap" type="button" class="btn btn-outlined" title="Every part on primary moves to secondary and back">Swap primary ⇄ secondary</button>
				<button id="logo-download" type="button" class="btn btn-outlined">Download svg</button>
			</div>
			<p id="logo-note" class="text-label-medium"></p>
			<label for="logo-changed">Changed from defaults, paste to load</label>
			<textarea id="logo-changed" rows="8" spellcheck="false"></textarea>
		</div>
		<div class="logo-stage">
			<div id="logo-preview"></div>
			<div id="logo-gaps"></div>
		</div>
	</div>
	<script src="/scripts/theme.js"></script>
	<script src="/scripts/logo.js"></script>
	<script src="/scripts/logo-designer.js"></script>
</article>
